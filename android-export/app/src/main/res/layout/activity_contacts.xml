<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:backgroundTint="@color/white"
            android:text="‹"
            android:textColor="@color/ink"
            android:textSize="24sp" />
        <TextView
            style="@style/ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Emergency contacts" />
        <Button
            android:id="@+id/btnCall911"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="Call 911 now" />
        <TextView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Philippine National Police\n117 · (02) 722-0650"
            android:textColor="@color/ink" />
        <TextView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Bureau of Fire Protection\n(02) 426-0219 · (02) 426-0246"
            android:textColor="@color/ink" />
        <TextView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="NDRRMC\n(02) 8911-1406 · (02) 8912-2665"
            android:textColor="@color/ink" />
        <TextView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Philippine Red Cross\n143 · (02) 8527-8385"
            android:textColor="@color/ink" />
        <TextView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Mental health crisis support\n1800-1888-1553"
            android:textColor="@color/ink" />
    </LinearLayout>
</ScrollView>
